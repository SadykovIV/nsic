{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nintendo Switch Image Converter",
  "version": "0.2.0",
  "identifier": "io.github.sadykoviv.nsic",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:9999",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nintendo Switch Image Converter",
        "width": 1120,
        "height": 860,
        "minWidth": 900,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "shortDescription": "Build XCI images from local Switch dumps",
    "longDescription": "Build and verify XCI images from user-provided NSP, NSZ, XCI and XCZ files.",
    "copyright": "Copyright © 2026 Ildar Sadykov",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
