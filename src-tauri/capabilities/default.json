{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the NSIC main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-open-path",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/SadykovIV/**" },
        { "url": "https://github.com/cxfcxf/**" },
        { "url": "https://github.com/julesontheroad/**" },
        { "url": "https://github.com/nicoboss/**" }
      ]
    }
  ]
}
